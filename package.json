{
  "name": "agent-server",
  "version": "0.0.1",
  "description": "Omnix agent-server (NestJS)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@8.5.1",
  "scripts": {
    "build": "nest build",
    "build:dev": "prisma generate && nest build",
    "build:test": "prisma generate && nest build",
    "build:prod": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=dev nest start --watch",
    "start:runtime:dev": "NODE_ENV=dev nest start --watch --entryFile runtime-main",
    "start:worker:dev": "NODE_ENV=dev nest start --watch --entryFile worker-main",
    "start:runtime:prod": "NODE_ENV=prod node dist/src/runtime-main.js",
    "start:worker:prod": "NODE_ENV=prod node dist/src/worker-main.js",
    "test:session-run-split": "bash scripts/test-session-run-split.sh",
    "start:test": "NODE_ENV=test nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=prod node dist/src/main.js",
    "start:server:prod": "pm2-runtime start ecosystem.config.cjs",
    "start:pm2": "pm2-runtime start ecosystem.config.cjs",
    "stop:pm2": "pm2 stop ecosystem.config.cjs",
    "reload:pm2": "pm2 reload ecosystem.config.cjs",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "codegen:prisma": "ts-node src/codegen/prisma-schema-codegen.ts --with-service --with-controller",
    "codegen:prisma:dry-run": "ts-node src/codegen/prisma-schema-codegen.ts --dry-run --with-service --with-controller",
    "codegen:swagger-tools:dry-run": "ts-node src/codegen/swagger-tool-cli.ts --dry-run",
    "codegen:swagger-tools:apply": "ts-node src/codegen/swagger-tool-cli.ts --apply",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:cov": "NODE_ENV=test jest --coverage",
    "test:debug": "NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json",
    "memory:redis-smoke": "ts-node -r tsconfig-paths/register src/core/memory/redis/redis-smoke.ts",
    "db:smoke": "ts-node -r tsconfig-paths/register src/core/env/db-smoke.ts",
    "db:bootstrap-remote": "ts-node -r tsconfig-paths/register prisma/scripts/remote-db-bootstrap.ts",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed-sample-skill": "ts-node prisma/scripts/seed-sample-skill.ts",
    "db:seed-prompts": "ts-node prisma/scripts/seed-prompt-templates.ts",
    "db:publish-prompts": "ts-node prisma/scripts/publish-prompt-templates.ts",
    "db:upsert-embedding": "ts-node prisma/scripts/upsert-transformers-embedding.ts",
    "db:migrate:user-auth-model": "ts-node prisma/scripts/migrate-user-role-to-new-model.ts",
    "db:backfill-app-client-auth": "ts-node prisma/scripts/backfill-app-client-auth-from-env.ts",
    "db:configure-app-client-2-auth": "ts-node prisma/scripts/configure-app-client-2-admin-auth.ts",
    "db:delete-public-buyer-tools": "ts-node prisma/scripts/delete-public-buyer-tools.ts",
    "db:delete-obsolete-prompts": "ts-node prisma/scripts/delete-obsolete-prompt-templates.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.5",
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/jwt": "^10.1.1",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/swagger": "^7.1.14",
    "@nestjs/throttler": "^4.2.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@xenova/transformers": "^2.17.2",
    "bullmq": "^5.79.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.2",
    "langchain": "^1.4.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pm2": "^6.0.14",
    "prisma": "^7.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "sharp": "0.34.2",
    "swagger-ui-express": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/express": "^4.17.13",
    "@types/jest": "29.5.1",
    "@types/node": "18.16.12",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "29.5.0",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "29.1.0",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
