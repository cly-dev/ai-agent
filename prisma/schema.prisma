// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ToolLevel {
  L1
  L2
  L3
}

enum HttpMethod {
  Get
  Post
  Put
  Delete
}

enum AdminRole {
  SUPER_ADMIN
  OPERATOR
  VIEWER
}

enum AgentRunStatus {
  running
  success
  failed
}

enum AgentRunRole {
  primary
  router
  worker
  reviewer
}

enum IntegrationAuthMode {
  USER_ONLY
  SYSTEM_ONLY
  USER_PREFERRED
}

/** LLM 库配置类型：对话模型 vs 本地 Transformers embedding vs 远程 embedding API。 */
enum LlmModelKind {
  chat
  transformers_embedding
  api_embedding
}

model User {
  id                 Int       @id @default(autoincrement())
  employeeId         String    @unique
  email              String
  password           String
  username           String
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())

  sessions         Session[]
  messageTurns     MessageTurn[]
  llmModelConfigs  UserLlmModelConfig[]
  userApps         UserApp[]
  userIntegrations UserIntegration[]
}

model Role {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  description    String?
  allowToolLevel ToolLevel @default(L1)
  createdAt      DateTime  @default(now())

  roleSkills RoleSkill[]
  userApps   UserApp[]
  roleTools  RoleTool[]

  @@map("role")
}

model AdminUser {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  password           String
  username           String
  role               AdminRole
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model AppClient {
  id          Int      @id @default(autoincrement())
  name        String
  dsn         String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agents       Agent[]
  tools        Tool[]
  sessions     Session[]
  messageTurns MessageTurn[]
  agentRuns    AgentRun[]
  integrations    Integration[]
  userApps        UserApp[]
  promptTemplates PromptTemplate[]
}

model LlmModelConfig {
  id           Int          @id @default(autoincrement())
  kind         LlmModelKind @default(chat)
  /** @deprecated 保留兼容旧数据；新配置以 kind 区分。 */
  singletonKey Int?
  provider     String       @default("openai-compatible")
  model        String
  apiKey       String?
  baseUrl      String
  chatPath     String       @default("/v1/chat/completions")
  parameters   Json?
  stream       Boolean      @default(false)
  maxTokens    Int?
  temperature  Float?
  enabled      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

/** 意图召回（向量 Top-K / bind 上限）；进程内缓存，管理端可改。 */
model IntentRecallConfig {
  id                Int      @id @default(1)
  singletonKey      Int      @unique @default(1)
  /** auto | vector | keyword */
  recallMode        String   @default("auto")
  vectorTopK        Int      @default(10)
  vectorMinScore    Float    @default(0.25)
  bindToolsMax      Int      @default(25)
  /** 向量/embedding 失败时是否降级关键词 */
  fallbackToKeyword Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserLlmModelConfig {
  id          Int      @id @default(autoincrement())
  userId      Int
  provider    String
  model       String
  apiKey      String
  baseUrl     String?
  temperature Float?
  maxTokens   Int?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id          String   @id @db.VarChar(32)
  userId      Int
  appClientId Int
  agentId     Int?
  title       String?
  createdAt   DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  appClient    AppClient    @relation(fields: [appClientId], references: [id])
  messages     Message[]
  agentRuns    AgentRun[]
  messageTurns MessageTurn[]

  @@index([userId])
  @@index([appClientId])
}

model Message {
  id        Int     @id @default(autoincrement())
  sessionId String
  role      String // user / assistant / tool / system
  content   String?

  toolName   String?
  toolInput  Json?
  toolOutput Json?

  createdAt DateTime @default(now())

  session            Session       @relation(fields: [sessionId], references: [id])
  messageTurns       MessageTurn[] @relation("MessageTurnInput")
  outputMessageTurns MessageTurn[] @relation("MessageTurnOutput")

  @@index([sessionId])
}

/// 工具业务分类（商品、订单、搜索等），由用户在后台自由增删
model ToolCategory {
  id          Int      @id @default(autoincrement())
  label       String
  description String?
  sortOrder   Int      @default(0)
  tools       Tool[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Tool {
  id             Int           @id @default(autoincrement())
  appClientId    Int
  /// 跨 App 可对齐的业务能力键；同一 appClientId 下唯一（一行 Tool = 该 App 上的一条可执行实现）
  definitionKey  String
  name           String
  description    String
  riskLevel      ToolLevel     @default(L1)
  schema         Json // 参数结构
  skillTools     SkillTool[]
  agentTools     AgentTool[]
  inputSchema    Json
  outputSchema   Json?
  /// 工具响应裁剪与字段语义（coreFields / optionalFields / arrayLimits）
  responseProfile Json?
  /// Agent 选工具：mode / resource / operation / businessFields / aliases 等
  agentMetadata   Json?
  method         HttpMethod
  path           String
  integrationId  Int
  integration    Integration   @relation(fields: [integrationId], references: [id])
  appClient      AppClient     @relation(fields: [appClientId], references: [id])
  toolCategoryId Int?
  toolCategory   ToolCategory? @relation(fields: [toolCategoryId], references: [id], onDelete: SetNull)
  roleTools      RoleTool[]
  isActive       Boolean       @default(true)
  timeout        Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([appClientId, definitionKey])
  @@index([toolCategoryId])
  @@index([appClientId])
  @@index([definitionKey])
}

model Integration {
  id          Int                 @id @default(autoincrement())
  appClientId Int
  name        String
  baseUrl     String
  apiKey      String?
  authMode    IntegrationAuthMode @default(USER_PREFERRED)
  description String?

  appClient        AppClient         @relation(fields: [appClientId], references: [id])
  tools            Tool[]
  userIntegrations UserIntegration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appClientId])
}

model UserIntegration {
  id            Int      @id @default(autoincrement())
  userId        Int
  integrationId Int
  userApiKey    String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([userId, integrationId])
  @@index([userId])
  @@index([integrationId])
}

/// Agent 专属技能包：意图命中时注入 prompt；SkillTool 须为 AgentTool 子集（gate），不替代 RoleTool 授权。
model Skill {
  id            Int      @id @default(autoincrement())
  agentId       Int
  name          String
  /// 跨 Agent 对齐的能力键（可选）；供后续 Role 按 capability 授权。
  capabilityKey String?
  description   String?
  prompt        String   @db.Text
  /// 与 Tool.riskLevel 同语义；L2/L3 表示含写操作，运行前需用户确认。
  riskLevel     ToolLevel @default(L1)
  config        Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agent      Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillTools SkillTool[]
  roleSkills RoleSkill[]

  @@unique([agentId, name])
  @@unique([agentId, capabilityKey])
  @@index([agentId, isActive])
}

/// Role 可用的 Skill 白名单（可选；与 RoleTool 并列，不间接授权 Tool）。
model RoleSkill {
  id      Int @id @default(autoincrement())
  roleId  Int
  skillId Int

  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([roleId, skillId])
  @@index([roleId])
  @@index([skillId])
  @@map("roleskill")
}

/// Skill 关联的本应用 Tool；用于运行时 gate（SkillTool ∩ 用户可用 Tool）。
model SkillTool {
  id         Int     @id @default(autoincrement())
  skillId    Int
  toolId     Int
  isRequired Boolean @default(false)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tool  Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([skillId, toolId])
  @@index([skillId])
  @@index([toolId])
}

model UserApp {
  id        Int      @id @default(autoincrement())
  userId    Int
  appId     Int
  roleId    Int
  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appClient AppClient @relation(fields: [appId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@index([userId])
  @@index([appId])
  @@index([roleId])
}

model RoleTool {
  id        Int      @id @default(autoincrement())
  roleId    Int
  toolId    Int
  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([roleId, toolId])
  @@index([roleId])
  @@index([toolId])
}

model Agent {
  id             Int      @id @default(autoincrement())
  appClientId    Int
  name           String
  description    String?
  systemPrompt   String
  maxSteps       Int      @default(8)
  enableToolCall Boolean  @default(true)
  config         Json?
  createdAt      DateTime @default(now())

  appClient    AppClient     @relation(fields: [appClientId], references: [id])
  skills       Skill[]
  agentRuns       AgentRun[]
  agentTools      AgentTool[]
  messageTurns    MessageTurn[]
  promptTemplates PromptTemplate[]

  @@index([appClientId])
}

/// 平台/Agent 提示词模板（按 key + 作用域 + version；每作用域仅一条 isActive）。
model PromptTemplate {
  id          Int      @id @default(autoincrement())
  key         String
  version     Int
  appClientId Int?
  agentId     Int?
  locale      String   @default("zh-CN")
  category    String?
  title       String?
  description String?
  content     String   @db.Text
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appClient AppClient? @relation(fields: [appClientId], references: [id], onDelete: Cascade)
  agent     Agent?     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([key, appClientId, agentId, locale, version])
  @@index([key, appClientId, agentId, locale, isActive])
  @@index([key, isActive])
}

/// 用户消息的一次 Agent 执行尝试；同一 message 可有多次尝试（多条 MessageTurn）。
model MessageTurn {
  id                 Int            @id @default(autoincrement())
  messageId          Int?
  sessionId          String
  userId             Int
  appClientId        Int
  userInput          String
  finalOutput        String?
  status             AgentRunStatus @default(running)
  primaryAgentId     Int?
  agentRunCount      Int            @default(0)
  durationMs         Int?
  llmDurationMs      Int?
  toolDurationMs     Int?
  model              String?
  promptTokens       Int?
  completionTokens   Int?
  totalTokens        Int?
  llmCallCount       Int            @default(0)
  toolCallCount      Int            @default(0)
  toolsUsed          Json?
  finishReason       String?
  outputMessageId    Int?
  startedAt          DateTime       @default(now())
  finishedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  message       Message?  @relation("MessageTurnInput", fields: [messageId], references: [id], onDelete: SetNull)
  outputMessage Message?  @relation("MessageTurnOutput", fields: [outputMessageId], references: [id], onDelete: SetNull)
  session      Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  appClient    AppClient  @relation(fields: [appClientId], references: [id], onDelete: Cascade)
  primaryAgent Agent?     @relation(fields: [primaryAgentId], references: [id], onDelete: SetNull)
  agentRuns    AgentRun[]

  @@index([messageId])
  @@index([outputMessageId])
  @@index([sessionId])
  @@index([userId])
  @@index([appClientId])
  @@index([status])
  @@index([createdAt])
  @@index([primaryAgentId])
}

model AgentRun {
  id               Int            @id @default(autoincrement())
  turnId           Int?
  agentId          Int
  appClientId      Int
  sessionId        String
  userId           Int?
  role             AgentRunRole   @default(primary)
  sequence         Int            @default(1)
  parentRunId      Int?
  input            String
  output           String?
  status           AgentRunStatus @default(running)
  steps            Json
  currentStep      Int            @default(0)
  maxSteps         Int
  error            String?
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?
  durationMs       Int?
  llmDurationMs    Int?
  toolDurationMs   Int?
  model            String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  llmCallCount     Int            @default(0)
  toolCallCount    Int            @default(0)
  toolsUsed        Json?
  finishReason     String?
  scopedToolCount  Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  turn       MessageTurn? @relation(fields: [turnId], references: [id], onDelete: Cascade)
  agent      Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  appClient  AppClient    @relation(fields: [appClientId], references: [id])
  session    Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parentRun  AgentRun?    @relation("AgentRunHierarchy", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns  AgentRun[]   @relation("AgentRunHierarchy")

  @@index([turnId])
  @@index([sessionId])
  @@index([agentId])
  @@index([appClientId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([parentRunId])
}

model AgentTool {
  id      Int @id @default(autoincrement())
  agentId Int
  toolId  Int

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool  Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolId])
  @@index([agentId])
  @@index([toolId])
}
