// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ToolLevel {
  L1
  L2
  L3
}

enum HttpMethod {
  Get
  Post
  Put
  Delete
}

enum AdminRole {
  SUPER_ADMIN
  OPERATOR
  VIEWER
}

enum AgentRunStatus {
  running
  success
  failed
}

enum AgentRunRole {
  primary
  router
  worker
  reviewer
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum IntegrationAuthMode {
  USER_ONLY
  SYSTEM_ONLY
  USER_PREFERRED
}

/// Skill 在何种 Plan 场景下关联 Host Tool。
enum HostToolSkillTrigger {
  /// Plan deliverable=mutation 且成功后可引用
  ON_MUTATION_SUCCESS
  /// 指定 Plan 步 / host 交互步（未来）
  ON_PLAN_STEP
  /// 本轮允许 LLM 选择调用
  LLM_SCOPED
}

/** LLM 库配置类型：对话模型 vs 本地 Transformers embedding vs 远程 embedding API。 */
enum LlmModelKind {
  chat
  transformers_embedding
  api_embedding
}

enum MessageFeedbackRating {
  up
  down
}

model User {
  id                 Int       @id @default(autoincrement())
  employeeId         String    @unique
  email              String
  password           String
  username           String
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())

  sessions         Session[]
  messageTurns     MessageTurn[]
  messageFeedbacks MessageFeedback[]
  llmModelConfigs  UserLlmModelConfig[]
  userApps         UserApp[]
  userIntegrations UserIntegration[]
  pageActionRuns   PageActionRun[]
  pageAgentLlmProxyAudits PageAgentLlmProxyAudit[]
  approvalsInitiated ApprovalRequest[] @relation("ApprovalInitiator")
  approvalsToApprove ApprovalRequest[] @relation("ApprovalApprover")
}

model Role {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  description    String?
  allowToolLevel ToolLevel @default(L1)
  createdAt      DateTime  @default(now())

  roleSkills RoleSkill[]
  userApps   UserApp[]
  roleTools  RoleTool[]
  roleHostTools RoleHostTool[]

  @@map("role")
}

model AdminUser {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  password           String
  username           String
  role               AdminRole
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model AppClient {
  id          Int      @id @default(autoincrement())
  name        String
  dsn         String   @unique
  description String?
  /// 按 App 的外部账号鉴权配置；为空时回退 APP_CLIENT_HOST 等环境变量。
  authConfig  Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agents       Agent[]
  tools        Tool[]
  sessions     Session[]
  messageTurns MessageTurn[]
  messageFeedbacks MessageFeedback[]
  agentRuns    AgentRun[]
  integrations    Integration[]
  userApps        UserApp[]
  promptTemplates PromptTemplate[]
  hostPages       HostPage[]
  hostTools       HostTool[]
  pageActions     PageAction[]
  pageActionRuns  PageActionRun[]
  workflows       Workflow[]
  flows           Flow[]
  skills          Skill[]
  approvalRequests ApprovalRequest[]
  pageAgentLlmProxyAudits PageAgentLlmProxyAudit[]
}

model LlmModelConfig {
  id           Int          @id @default(autoincrement())
  kind         LlmModelKind @default(chat)
  /** @deprecated 保留兼容旧数据；新配置以 kind 区分。 */
  singletonKey Int?
  provider     String       @default("openai-compatible")
  model        String
  apiKey       String?
  baseUrl      String
  chatPath     String       @default("/v1/chat/completions")
  parameters   Json?
  stream       Boolean      @default(false)
  maxTokens    Int?
  temperature  Float?
  enabled      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  pageAgentLlmProxyAudits PageAgentLlmProxyAudit[]
}

/// C 端 PageAgent LLM 代理调用审计；不保存完整 messages，避免落库页面 DOM / 隐私文本。
model PageAgentLlmProxyAudit {
  id               Int      @id @default(autoincrement())
  appClientId      Int
  userId           Int
  modelConfigId    Int?
  requestedModel   String?
  provider         String?
  providerModel    String?
  status           String   @default("running")
  upstreamStatus   Int?
  durationMs       Int?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  requestMeta      Json?
  errorMessage     String?  @db.Text
  createdAt        DateTime @default(now())
  finishedAt       DateTime?

  appClient   AppClient       @relation(fields: [appClientId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelConfig LlmModelConfig? @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)

  @@index([appClientId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([modelConfigId])
}

/** 意图召回（向量 Top-K / bind 上限）；进程内缓存，管理端可改。 */
model IntentRecallConfig {
  id                Int      @id @default(1)
  singletonKey      Int      @unique @default(1)
  /** auto | vector | keyword */
  recallMode        String   @default("auto")
  vectorTopK        Int      @default(10)
  vectorMinScore    Float    @default(0.25)
  bindToolsMax      Int      @default(25)
  /** 向量/embedding 失败时是否降级关键词 */
  fallbackToKeyword Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserLlmModelConfig {
  id          Int      @id @default(autoincrement())
  userId      Int
  provider    String
  model       String
  apiKey      String
  baseUrl     String?
  temperature Float?
  maxTokens   Int?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id          String   @id @db.VarChar(32)
  userId      Int
  appClientId Int
  agentId     Int?
  title       String?
  createdAt   DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id])
  appClient       AppClient        @relation(fields: [appClientId], references: [id])
  messages        Message[]
  agentRuns       AgentRun[]
  messageTurns    MessageTurn[]
  messageFeedbacks MessageFeedback[]
  sessionGoaMemory SessionGoaMemory?

  @@index([userId])
  @@index([appClientId])
}

/// 会话 GOA 记忆（DB 权威源）；Redis 仅作读缓存。
model SessionGoaMemory {
  sessionId String   @id @db.VarChar(32)
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Message {
  id        Int     @id @default(autoincrement())
  sessionId String
  role      String // user / assistant / tool / system
  content   String?

  toolName   String?
  toolInput  Json?
  toolOutput Json?
  /// 用户消息附带的页面上下文（omnix-chat pageContext）
  pageContextJson Json?

  createdAt DateTime @default(now())

  session            Session       @relation(fields: [sessionId], references: [id])
  messageTurns       MessageTurn[] @relation("MessageTurnInput")
  outputMessageTurns MessageTurn[] @relation("MessageTurnOutput")
  agentRunOutputs    AgentRun[]    @relation("AgentRunOutput")
  feedbacks          MessageFeedback[]

  @@index([sessionId])
}

/// C 端用户对 assistant 消息的赞/踩；点踩须附带原因（标签和/或补充说明）。
model MessageFeedback {
  id          Int                   @id @default(autoincrement())
  messageId   Int
  sessionId   String                @db.VarChar(32)
  userId      Int
  appClientId Int
  turnId      Int?
  agentId     Int?
  rating      MessageFeedbackRating
  reasonTags  Json?
  comment     String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appClient AppClient @relation(fields: [appClientId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([sessionId])
  @@index([userId])
  @@index([appClientId, rating])
  @@index([turnId])
  @@index([agentId])
}

/// 工具业务分类（商品、订单、搜索等），由用户在后台自由增删
model ToolCategory {
  id          Int      @id @default(autoincrement())
  label       String
  description String?
  sortOrder   Int      @default(0)
  tools       Tool[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Tool {
  id             Int           @id @default(autoincrement())
  appClientId    Int
  /// 跨 App 可对齐的业务能力键；同一 appClientId 下唯一（一行 Tool = 该 App 上的一条可执行实现）
  definitionKey  String
  name           String
  description    String
  riskLevel      ToolLevel     @default(L1)
  schema         Json // 参数结构
  skillTools     SkillTool[]
  agentTools     AgentTool[]
  workflowTools  WorkflowTool[]
  flowTools      FlowTool[]
  inputSchema    Json
  outputSchema   Json?
  /// 工具响应裁剪与字段语义（coreFields / optionalFields / arrayLimits）
  responseProfile Json?
  /// Agent 选工具：mode / resource / operation / businessFields / aliases 等
  agentMetadata   Json?
  method         HttpMethod
  path           String
  integrationId  Int
  integration    Integration   @relation(fields: [integrationId], references: [id])
  appClient      AppClient     @relation(fields: [appClientId], references: [id])
  toolCategoryId Int?
  toolCategory   ToolCategory? @relation(fields: [toolCategoryId], references: [id], onDelete: SetNull)
  roleTools      RoleTool[]
  isActive       Boolean       @default(true)
  timeout        Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([appClientId, definitionKey])
  @@index([toolCategoryId])
  @@index([appClientId])
  @@index([definitionKey])
}

model Integration {
  id          Int                 @id @default(autoincrement())
  appClientId Int
  name        String
  baseUrl     String
  apiKey      String?
  authMode    IntegrationAuthMode @default(USER_PREFERRED)
  description String?

  appClient        AppClient         @relation(fields: [appClientId], references: [id])
  tools            Tool[]
  userIntegrations UserIntegration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appClientId])
}

model UserIntegration {
  id            Int      @id @default(autoincrement())
  userId        Int
  integrationId Int
  userApiKey    String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([userId, integrationId])
  @@index([userId])
  @@index([integrationId])
}

/// App 级技能包：意图命中时注入 prompt；SkillTool 为 App 候选池子集（gate），不替代 RoleTool 授权。
model Skill {
  id            Int      @id @default(autoincrement())
  appClientId   Int
  name          String
  /// 跨 Agent 对齐的能力键（可选）；供 Role 按 capability 授权。
  capabilityKey String?
  description   String?
  prompt        String   @db.Text
  /// 与 Tool.riskLevel 同语义；L2/L3 表示含写操作，运行前需用户确认。
  riskLevel     ToolLevel @default(L1)
  config        Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workflowId         Int?
  workflowVersion    Int?
  workflowOverrides  Json?
  workflow           Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  /// 新 Intent/IR 资产（与 legacy Workflow 分表）
  flowId             Int?
  flowVersion        Int?
  flow               Flow? @relation(fields: [flowId], references: [id], onDelete: SetNull)

  appClient    AppClient     @relation(fields: [appClientId], references: [id], onDelete: Cascade)
  agentSkills  AgentSkill[]
  skillTools   SkillTool[]
  skillHostTools SkillHostTool[]
  roleSkills   RoleSkill[]

  @@unique([appClientId, name])
  @@unique([appClientId, capabilityKey])
  @@index([appClientId, isActive])
  @@index([workflowId])
  @@index([flowId])
}

/// Agent 可见 Skill 白名单（收紧模式）；默认共享 App 级 Skill 库时可为空。
model AgentSkill {
  id      Int @id @default(autoincrement())
  agentId Int
  skillId Int

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
  @@index([agentId])
  @@index([skillId])
}

/// Role 可用的 Skill 白名单（可选；与 RoleTool 并列，不间接授权 Tool）。
model RoleSkill {
  id      Int @id @default(autoincrement())
  roleId  Int
  skillId Int

  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([roleId, skillId])
  @@index([roleId])
  @@index([skillId])
  @@map("roleskill")
}

/// Skill 关联的本应用 Tool；用于运行时 gate（SkillTool ∩ 用户可用 Tool）。
model SkillTool {
  id         Int     @id @default(autoincrement())
  skillId    Int
  toolId     Int
  isRequired Boolean @default(false)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tool  Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([skillId, toolId])
  @@index([skillId])
  @@index([toolId])
}

model UserApp {
  id        Int      @id @default(autoincrement())
  userId    Int
  appId     Int
  roleId    Int
  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appClient AppClient @relation(fields: [appId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@index([userId])
  @@index([appId])
  @@index([roleId])
}

model RoleTool {
  id        Int      @id @default(autoincrement())
  roleId    Int
  toolId    Int
  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([roleId, toolId])
  @@index([roleId])
  @@index([toolId])
}

model Agent {
  id             Int      @id @default(autoincrement())
  appClientId    Int
  name           String
  description    String?
  systemPrompt   String
  maxSteps       Int      @default(8)
  enableToolCall Boolean  @default(true)
  /// true：仅 AgentTool 白名单内 HTTP Tool 进入候选池；false 且白名单为空时用 App 全集。
  restrictTools      Boolean @default(false)
  /// true：仅 AgentHostTool 白名单内 Host Tool 进入候选池。
  restrictHostTools  Boolean @default(false)
  /// true：仅 AgentSkill 白名单内 Skill 可见；false 且白名单为空时用 App 全集。
  restrictSkills     Boolean @default(false)
  config         Json?
  createdAt      DateTime @default(now())

  appClient       AppClient       @relation(fields: [appClientId], references: [id])
  agentSkills     AgentSkill[]
  agentRuns       AgentRun[]
  agentTools      AgentTool[]
  agentHostTools  AgentHostTool[]
  messageTurns    MessageTurn[]
  promptTemplates PromptTemplate[]

  @@index([appClientId])
}

/// 平台/Agent 提示词模板（按 key + 作用域 + version；每作用域仅一条 isActive）。
model PromptTemplate {
  id          Int      @id @default(autoincrement())
  key         String
  version     Int
  appClientId Int?
  agentId     Int?
  locale      String   @default("zh-CN")
  category    String?
  title       String?
  description String?
  content     String   @db.Text
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appClient AppClient? @relation(fields: [appClientId], references: [id], onDelete: Cascade)
  agent     Agent?     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([key, appClientId, agentId, locale, version])
  @@index([key, appClientId, agentId, locale, isActive])
  @@index([key, isActive])
}

/// 用户消息的一次 Agent 执行尝试；同一 message 可有多次尝试（多条 MessageTurn）。
model MessageTurn {
  id                 Int            @id @default(autoincrement())
  messageId          Int?
  sessionId          String
  userId             Int
  appClientId        Int
  userInput          String
  finalOutput        String?
  status             AgentRunStatus @default(running)
  primaryAgentId     Int?
  agentRunCount      Int            @default(0)
  durationMs         Int?
  llmDurationMs      Int?
  toolDurationMs     Int?
  model              String?
  promptTokens       Int?
  completionTokens   Int?
  totalTokens        Int?
  llmCallCount       Int            @default(0)
  toolCallCount      Int            @default(0)
  toolsUsed          Json?
  finishReason       String?
  outputMessageId    Int?
  startedAt          DateTime       @default(now())
  finishedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  message       Message?  @relation("MessageTurnInput", fields: [messageId], references: [id], onDelete: SetNull)
  outputMessage Message?  @relation("MessageTurnOutput", fields: [outputMessageId], references: [id], onDelete: SetNull)
  session      Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  appClient    AppClient  @relation(fields: [appClientId], references: [id], onDelete: Cascade)
  primaryAgent Agent?     @relation(fields: [primaryAgentId], references: [id], onDelete: SetNull)
  agentRuns    AgentRun[]

  @@index([messageId])
  @@index([outputMessageId])
  @@index([sessionId])
  @@index([userId])
  @@index([appClientId])
  @@index([status])
  @@index([createdAt])
  @@index([primaryAgentId])
}

model AgentRun {
  id               Int            @id @default(autoincrement())
  turnId           Int?
  agentId          Int
  appClientId      Int
  sessionId        String
  userId           Int?
  role             AgentRunRole   @default(primary)
  sequence         Int            @default(1)
  parentRunId      Int?
  input            String
  output           String?
  status           AgentRunStatus @default(running)
  steps            Json
  currentStep      Int            @default(0)
  maxSteps         Int
  error            String?
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?
  durationMs       Int?
  llmDurationMs    Int?
  toolDurationMs   Int?
  model            String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  llmCallCount     Int            @default(0)
  toolCallCount    Int            @default(0)
  toolsUsed        Json?
  finishReason     String?
  scopedToolCount  Int?
  /// 本轮 run 落库的 assistant Message（幂等重试时复用）。
  outputMessageId  Int?
  /// Run 结束时的 Plan / activeTask 快照，供 GOA 冷启动 replay 权威恢复。
  goaSnapshot        Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  turn          MessageTurn? @relation(fields: [turnId], references: [id], onDelete: Cascade)
  outputMessage Message?     @relation("AgentRunOutput", fields: [outputMessageId], references: [id], onDelete: SetNull)
  agent      Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  appClient  AppClient    @relation(fields: [appClientId], references: [id])
  session    Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parentRun  AgentRun?    @relation("AgentRunHierarchy", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns  AgentRun[]   @relation("AgentRunHierarchy")

  @@index([turnId])
  @@index([sessionId])
  @@index([agentId])
  @@index([appClientId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([parentRunId])
  @@index([outputMessageId])
}

model AgentTool {
  id      Int @id @default(autoincrement())
  agentId Int
  toolId  Int

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool  Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolId])
  @@index([agentId])
  @@index([toolId])
}

/// App 内可嵌入 Chat 的业务页登记；scope 与 pageContext.page / host_action.scope 对齐。
model HostPage {
  id          Int      @id @default(autoincrement())
  appClientId Int
  /// 稳定页面标识，kebab-case，如 review-detail
  scope       String
  label       String
  description String?
  /// 可选：路由匹配提示（文档/管理端用；运行时仍以宿主传入 routePath 为准）
  routePattern String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appClient AppClient  @relation(fields: [appClientId], references: [id], onDelete: Cascade)
  hostTools HostTool[]

  @@unique([appClientId, scope])
  @@index([appClientId, isActive])
}

/// 前端 Host Tool 元数据（执行在浏览器；与 HTTP Tool 并列但不同命名空间）。
/// hostPageId 为空 = App 内通用工具（如 refreshEntity）；非空 = 仅该页可用。
model HostTool {
  id             Int              @id @default(autoincrement())
  appClientId    Int
  hostPageId     Int?
  /// App 内稳定键；通用工具如 refreshEntity，页内工具如 review-detail.fillReplyDraft
  definitionKey  String
  /// LLM / host_action 使用的工具名；同一 AppClient 内唯一
  name           String
  description    String           @db.Text
  /// 参数 JSON Schema（供 LLM 与前端校验）
  argsSchema     Json
  /// 完成通知等场景的参数模板，如 { "entityId": "$entity.id" }
  argsTemplate   Json?
  sortOrder      Int              @default(0)
  isActive       Boolean          @default(true)
  /// 扩展配置（埋点 reason、UI 提示等）
  config         Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  appClient      AppClient         @relation(fields: [appClientId], references: [id], onDelete: Cascade)
  hostPage       HostPage?         @relation(fields: [hostPageId], references: [id], onDelete: Cascade)
  agentHostTools AgentHostTool[]
  skillHostTools SkillHostTool[]
  roleHostTools  RoleHostTool[]
  pageActions    PageAction[]
  workflowHostTools WorkflowHostTool[]
  flowHostTools     FlowHostTool[]

  @@unique([appClientId, definitionKey])
  @@unique([appClientId, name])
  @@index([appClientId])
  @@index([hostPageId])
  @@index([appClientId, isActive])
}

/// Agent 可用的 Host Tool 白名单（类比 AgentTool）。
model AgentHostTool {
  id         Int      @id @default(autoincrement())
  agentId    Int
  hostToolId Int
  createdAt  DateTime @default(now())

  agent    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  hostTool HostTool @relation(fields: [hostToolId], references: [id], onDelete: Cascade)

  @@unique([agentId, hostToolId])
  @@index([agentId])
  @@index([hostToolId])
}

/// Skill 关联的 Host Tool；运行时 gate：SkillHostTool ∩ AgentHostTool ∩ pageContext.page。
model SkillHostTool {
  id         Int                  @id @default(autoincrement())
  skillId    Int
  hostToolId Int
  trigger    HostToolSkillTrigger @default(ON_MUTATION_SUCCESS)
  /// 覆盖 HostTool.argsTemplate（可选）
  argsTemplate Json?
  priority   Int                  @default(0)
  isRequired Boolean              @default(false)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  hostTool HostTool @relation(fields: [hostToolId], references: [id], onDelete: Cascade)

  @@unique([skillId, hostToolId])
  @@index([skillId])
  @@index([hostToolId])
}

/// Role 可用的 Host Tool 白名单（类比 RoleTool；可选用户侧授权）。
model RoleHostTool {
  id         Int      @id @default(autoincrement())
  roleId     Int
  hostToolId Int
  createdAt  DateTime @default(now())

  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  hostTool HostTool @relation(fields: [hostToolId], references: [id], onDelete: Cascade)

  @@unique([roleId, hostToolId])
  @@index([roleId])
  @@index([hostToolId])
}

/// Page Bot 交付方式：仅 inline_stream（sync 已废弃，DB 枚举保留兼容）。
enum PageActionDelivery {
  inline_stream
  sync
}

enum PageActionRunStatus {
  running
  awaiting_approval
  completed
  failed
  cancelled
}

/// 页内 one-shot 能力（绑定 HostTool；后台注册后 C 端方可 invoke）。
model PageAction {
  id            Int                @id @default(autoincrement())
  appClientId   Int
  /// App 内稳定键，如 demo-playground.fill_draft
  actionKey     String
  name          String
  description   String?
  /// 轻量路径必填；绑定 workflowId 时可由 Workflow generate_and_push 节点推导
  hostToolId    Int?
  /// 与 pageContext.page 对齐；空表示通用/不限页
  pageScope     String?
  systemPrompt  String             @db.Text
  defaultDelivery PageActionDelivery @default(inline_stream)
  allowCustomInstruction Boolean   @default(true)
  isActive      Boolean            @default(true)
  sortOrder     Int                @default(0)
  config        Json?
  /// 仅从 Skill 导入时的追溯；运行时不用
  sourceSkillId Int?
  workflowId         Int?
  workflowVersion    Int?
  workflowOverrides  Json?
  flowId             Int?
  flowVersion        Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  appClient AppClient       @relation(fields: [appClientId], references: [id], onDelete: Cascade)
  hostTool  HostTool?       @relation(fields: [hostToolId], references: [id], onDelete: Restrict)
  workflow  Workflow?       @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  flow      Flow?           @relation(fields: [flowId], references: [id], onDelete: SetNull)
  runs      PageActionRun[]

  @@unique([appClientId, actionKey])
  @@index([appClientId, isActive])
  @@index([appClientId, pageScope, isActive])
  @@index([hostToolId])
  @@index([workflowId])
  @@index([flowId])
}

/// 每次 PageAction invoke 的审计记录（无 Session / AgentRun）。
model PageActionRun {
  id               Int                  @id @default(autoincrement())
  pageActionId     Int
  appClientId      Int
  userId           Int
  delivery         PageActionDelivery
  status           PageActionRunStatus  @default(running)
  instruction      String?              @db.Text
  context          Json?
  pageContext      Json?
  fillText         String?              @db.Text
  dslOutcome       String?
  errorCode        String?
  errorMessage     String?
  streamId         String?
  model            String?
  promptTokens     Int?
  completionTokens Int?
  durationMs       Int?
  idempotencyKey   String?
  /// invoke 时由 pageContext 等输入稳定序列化后 hash 得到的去重键（同用户 + 同 PageAction + 同 key 不重复执行）。
  pageActionKey    String?
  clientActionId   String?
  /// 运行步骤审计（lifecycle / llm / dsl），供 B 端后台展示。
  steps            Json                 @default("[]")
  workflowId       Int?
  workflowVersion  Int?
  /// Flow 运行审计（与 workflowId 二选一；不再把 flowId 写入 Workflow FK）
  flowId           Int?
  flowVersion      Int?
  workflowRun      Json?
  /// 与 host_action SSE generation 对齐；默认等于 run id。
  generation       Int                  @default(1)
  createdAt        DateTime             @default(now())
  finishedAt       DateTime?

  pageAction PageAction @relation(fields: [pageActionId], references: [id], onDelete: Cascade)
  appClient  AppClient  @relation(fields: [appClientId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  flow       Flow?      @relation(fields: [flowId], references: [id], onDelete: SetNull)

  @@index([pageActionId, createdAt])
  @@index([appClientId, userId, createdAt])
  @@index([appClientId, idempotencyKey])
  @@index([pageActionId, userId, pageActionKey])
  @@index([flowId])

  approvalRequest ApprovalRequest?
}

/// 审批请求来源（触发链路）。
enum ApprovalSource {
  chat
  page_action
  webhook
}

/// 审批请求状态机。
enum ApprovalStatus {
  pending
  approved
  rejected
  expired
  cancelled
}

/// 统一审批请求：chat / pageAction / webhook 共享的待审批 SSOT（持久、可跨进程恢复）。
model ApprovalRequest {
  id              Int            @id @default(autoincrement())
  appClientId     Int
  source          ApprovalSource
  status          ApprovalStatus @default(pending)
  /// 谁/什么触发（webhook 无人类发起人时为 null）——审计用，非授权判定字段
  initiatorUserId Int?
  /// 谁必须审批（权威决策字段）：chat/pageAction = 发起人；webhook = workflow 配置指定
  approverUserId  Int
  /// legacy Workflow 资产；与 flowId 二选一
  workflowId      Int?
  workflowVersion Int?
  /// 新 Flow 资产；与 workflowId 二选一
  flowId          Int?
  flowVersion     Int?
  /// 挂起节点
  nodeId          String
  /// C 端展示用（标题 / 摘要 / 待写参数预览），不含敏感全量
  title           String
  summary         String?        @db.Text
  previewBlocks   Json?
  /// 通用恢复快照（ApprovalResumeSnapshot 序列化）
  resumeSnapshot  Json
  /// 关联触发实体（可选，用于回链与幂等）
  pageActionRunId Int?           @unique
  sessionId       String?
  /// 幂等 & 并发确认保护
  idempotencyKey  String?
  decidedByUserId Int?
  decidedAt       DateTime?
  decisionNote    String?        @db.Text
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  appClient     AppClient      @relation(fields: [appClientId], references: [id], onDelete: Cascade)
  initiator     User?          @relation("ApprovalInitiator", fields: [initiatorUserId], references: [id], onDelete: SetNull)
  approver      User           @relation("ApprovalApprover", fields: [approverUserId], references: [id], onDelete: Cascade)
  workflow      Workflow?      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  flow          Flow?          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  pageActionRun PageActionRun? @relation(fields: [pageActionRunId], references: [id], onDelete: SetNull)

  @@index([appClientId, approverUserId, status, createdAt])
  @@index([appClientId, status])
  @@index([workflowId])
  @@index([flowId])
}

enum WorkflowProfile {
  chat_skill
  page_action
  shared
}

enum WorkflowDeliverable {
  analysis
  list
  detail
  mutation
  answer
}

/// Legacy Workflow：旧版原子 action 图（nodes IR）。新 Intent/IR 请用 Flow。
model Workflow {
  id            Int                 @id @default(autoincrement())
  appClientId   Int
  workflowKey   String
  name          String
  description   String?
  goal          String?             @db.Text
  profile       WorkflowProfile
  deliverable   WorkflowDeliverable @default(answer)
  /** Legacy 图文档：{ nodes, edges, entryNodeId } */
  nodes         Json
  version       Int                 @default(1)
  constraints   Json                @default("[]")
  isActive      Boolean             @default(true)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  appClient         AppClient          @relation(fields: [appClientId], references: [id], onDelete: Cascade)
  workflowTools     WorkflowTool[]
  workflowHostTools WorkflowHostTool[]
  revisions         WorkflowRevision[]
  skills            Skill[]
  pageActions       PageAction[]
  approvalRequests  ApprovalRequest[]

  @@unique([appClientId, workflowKey])
  @@index([appClientId, isActive])
}

model WorkflowRevision {
  id          Int                 @id @default(autoincrement())
  workflowId  Int
  version     Int
  nodes       Json
  deliverable WorkflowDeliverable
  constraints Json                @default("[]")
  changeNote  String?
  createdAt   DateTime            @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([workflowId, version])
}

model WorkflowTool {
  id         Int     @id @default(autoincrement())
  workflowId Int
  toolId     Int
  isRequired Boolean @default(false)

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tool     Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([workflowId, toolId])
  @@index([workflowId])
  @@index([toolId])
}

model WorkflowHostTool {
  id         Int     @id @default(autoincrement())
  workflowId Int
  hostToolId Int
  isRequired Boolean @default(false)

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  hostTool HostTool @relation(fields: [hostToolId], references: [id], onDelete: Cascade)

  @@unique([workflowId, hostToolId])
  @@index([workflowId])
  @@index([hostToolId])
}

/// 新编排资产：Intent SSOT + 编译 IR（与 legacy Workflow 分表）。
model Flow {
  id            Int                 @id @default(autoincrement())
  appClientId   Int
  flowKey       String
  name          String
  description   String?
  goal          String?             @db.Text
  profile       WorkflowProfile
  deliverable   WorkflowDeliverable @default(answer)
  /** WorkflowIntent JSON */
  intent        Json
  /** WorkflowIrDocument JSON */
  ir            Json
  version       Int                 @default(1)
  constraints   Json                @default("[]")
  isActive      Boolean             @default(true)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  appClient    AppClient     @relation(fields: [appClientId], references: [id], onDelete: Cascade)
  flowTools    FlowTool[]
  flowHostTools FlowHostTool[]
  revisions    FlowRevision[]
  skills       Skill[]
  pageActions  PageAction[]
  pageActionRuns PageActionRun[]
  approvalRequests ApprovalRequest[]

  @@unique([appClientId, flowKey])
  @@index([appClientId, isActive])
}

model FlowRevision {
  id          Int                 @id @default(autoincrement())
  flowId      Int
  version     Int
  intent      Json
  ir          Json
  deliverable WorkflowDeliverable
  constraints Json                @default("[]")
  changeNote  String?
  createdAt   DateTime            @default(now())

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, version])
  @@index([flowId, version])
}

model FlowTool {
  id         Int     @id @default(autoincrement())
  flowId     Int
  toolId     Int
  isRequired Boolean @default(false)

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([flowId, toolId])
  @@index([flowId])
  @@index([toolId])
}

model FlowHostTool {
  id         Int     @id @default(autoincrement())
  flowId     Int
  hostToolId Int
  isRequired Boolean @default(false)

  flow     Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  hostTool HostTool @relation(fields: [hostToolId], references: [id], onDelete: Cascade)

  @@unique([flowId, hostToolId])
  @@index([flowId])
  @@index([hostToolId])
}
