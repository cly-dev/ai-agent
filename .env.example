# Copy to .env (development), .env.test, or .env.prod per environment.

# PostgreSQL (required)
DATABASE_URL=postgresql://user:pass@localhost:5432/agent

# Auth (required in production: ≥32 chars, not a default placeholder)
JWT_SECRET=change-me-use-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# CORS allowlist for all APIs (B-end /admin + C-end public routes).
# Comma-separated Origins. Unset in dev → reflect request Origin; production must set explicitly.
# CORS_ORIGINS=https://admin.example.com,https://app.example.com,http://localhost:5173
# Legacy alias (still supported if CORS_ORIGINS is unset):
CLIENT_CORS_ORIGINS=https://app.example.com,http://localhost:5173

# Production defaults: Swagger off, www/ static off; debug logs/files always off (NODE_ENV=prod).
# ENABLE_SWAGGER=0
# ENABLE_DEV_STATIC=0

# Redis (optional — empty REDIS_URL + REDIS_HOST → in-memory session-run queue fallback)
REDIS_URL=redis://localhost:6379
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Session run job queue (BullMQ on Redis; requires REDIS_URL or REDIS_HOST)
# 双进程部署（阶段 2）：
#   Runtime API (runtime-main)  → SESSION_RUN_WORKER_ENABLED=0  SESSION_RUN_HTTP_ENABLED=1
#   Worker      (worker-main)   → SESSION_RUN_WORKER_ENABLED=1  SESSION_RUN_HTTP_ENABLED=0
# Legacy 单体 (main)            → 两者默认均为 1（本地 start:dev）
# SESSION_RUN_WORKER_ENABLED=1
# SESSION_RUN_HTTP_ENABLED=1
# SESSION_RUN_WORKER_CONCURRENCY=8
# SESSION_RUN_JOB_ATTEMPTS=3
# WORKER_HEALTH_PORT=3031        # worker-main 轻量 /health（非完整 Nest HTTP）
# Per-session drain lock renews every 60s while a job runs (lock TTL 5min in Redis).

# Session / user memory TTL (seconds)
MEMORY_USER_TTL_SECONDS=0
MEMORY_SESSION_TTL_SECONDS=604800

# Prompt budget (Late Binding — fit before LLM invoke; see docs/prompt-budget.md)
# PROMPT_BUDGET_ENABLED=1
# PROMPT_BUDGET_SAFETY_MARGIN_RATIO=0.08
# PROMPT_OBS_MAX_RECORDS_L1=20
# PROMPT_OBS_FIELD_PREVIEW_CHARS=500
# PROMPT_OBS_LONG_FIELD_THRESHOLD=800

# AppClient SDK auth (C-end); falls back when AppClient.authConfig is empty
APP_CLIENT_HOST=https://admin.example.com

# V2 LangGraph 主轴（workflow_init → execute_node → workflow_advance）；固定开启，无 legacy 回退。

# Workflow 追溯日志 → logs/workflow/run-{runId}.log（非生产；默认跟随 AGENT_ENGINE_DEBUG）
# WORKFLOW_DEBUG=1

# Workflow 触发权限 fail-fast 校验（派生自 write_data.toolId 的 RoleTool）；默认开启，设 false 跳过（运行时工具门仍生效，用于迁移回滚）
# WORKFLOW_TRIGGER_PERMISSION=false
# Embedding: prefer DB LlmModelConfig (kind=transformers_embedding); env vars in llm.service are optional fallback.

# Host Tool DSL 真流式（机器层 streamChat → arg.append）；默认开启；0=回退 v0 批量
# HOST_TOOL_STREAM=0

# 图片识别（summarize_images / IMAGE_PANEL vision）。默认开启；画布未配节点时不会调用。
# 未装 sharp / 无 VL 模型的环境可设 0：即便画布有节点也 degrade，不调多模态。
# ENABLE_IMAGE_PANEL_VISION=0
# 进程内 URL→摘要缓存条数硬顶（默认 256，范围约 16..2048）
# IMAGE_PANEL_SUMMARY_CACHE_MAX=256

# PageAgent C 端 OpenAI-compatible LLM 代理上游超时（毫秒）；默认 60000
PAGE_AGENT_PROXY_TIMEOUT_MS=60000

# 出站 HTTP 治理（统一 OutboundHttpService；详见 v2/docs/outbound-network-guide.md）
LLM_OUTBOUND_TIMEOUT_MS=120000
LLM_EMBEDDING_TIMEOUT_MS=30000
TOOL_DEFAULT_TIMEOUT_MS=10000
INTEGRATION_PROBE_TIMEOUT_MS=10000
APP_CLIENT_AUTH_TIMEOUT_MS=15000

# 写确认门 / 审批草稿重试上限（每 gate 周期；不设或 ≤0 或 unlimited = 不限制）
# DRAFT_REVIEW_MAX_RETRIES=5
