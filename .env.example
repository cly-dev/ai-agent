# Copy one template per environment:
# - .env       (development)
# - .env.test  (test)
# - .env.prod  (production)

# PostgreSQL (required)
DATABASE_URL=postgresql://user:pass@localhost:5432/agent

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Redis (optional)
# If REDIS_URL and REDIS_HOST are both empty, memory stores are read-only fallback.
REDIS_URL=redis://localhost:6379
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Memory TTL
# user memory: 0 means never expire
MEMORY_USER_TTL_SECONDS=0
# session context: must be > 0
MEMORY_SESSION_TTL_SECONDS=604800

# AppClient SDK auth (C-end); x-account-token 鉴权通过后自动建档 User + UserApp
APP_CLIENT_HOST=https://admin.example.com
# APP_CLIENT_AUTO_BIND_ROLE=operator

# Intent recall — prefer DB `IntentRecallConfig` + `LlmModelConfig(kind=transformers_embedding)`
# API: GET/PUT /llm-model-config/intent-recall , PUT /llm-model-config (kind in body)
# Env below is fallback when DB row missing
# auto = use vector when transformers_embedding enabled; else keyword
# AGENT_INTENT_RECALL_MODE=auto
# AGENT_INTENT_VECTOR_TOP_K=10
# AGENT_INTENT_VECTOR_MIN_SCORE=0.25
# AGENT_BIND_TOOLS_MAX=25
# Bind recall after category/metadata filter (>5 candidates → vector/keyword Top-5):
# AGENT_BIND_FULL_MAX=5
# AGENT_BIND_RECALL_MAX=5
# AGENT_INTENT_FALLBACK_KEYWORD=1
# LLM_MODEL_CONFIG_CACHE_TTL_SECONDS=3600
# INTENT_RECALL_CONFIG_CACHE_TTL_SECONDS=3600
# Skill 召回（默认比 intent 更严，降低误命中）
# SKILL_VECTOR_MIN_SCORE=0.38
# SKILL_VECTOR_MIN_SCORE_FLOOR=0.38
# SKILL_KEYWORD_MIN_SCORE=0.35
# SKILL_SINGLE_MIN_SCORE=0.42
# SKILL_RECALL_MIN_GAP=0.08
# L0 miss 后 L1 prompt 摘要二次召回（默认开启；0 关闭）
# SKILL_PROGRESSIVE_RECALL=1
# SKILL_PROGRESSIVE_RECALL_MAX_CANDIDATES=5
# SKILL_RECALL_PROMPT_EXCERPT_CHARS=300

# Plan 节点：默认 LLM 拆步骤；PLAN_LLM=0 时仅用规则 template。Skill.config.workflow 仍优先。
# PLAN_SKILL_PROMPT_EXCERPT_CHARS=1200

# Tool invoke：可重试错误（超时/502/503/504/429）最多重试次数（默认 2，即最多 3 次调用）
# TOOL_INVOKE_MAX_RETRIES=2
# LIST 工具未传分页参数时的默认值（page/size 自动补全；arrayLimits 默认与 size 对齐）
# TOOL_LIST_DEFAULT_PAGE=1
# TOOL_LIST_DEFAULT_SIZE=100
# TOOL_LIST_ARRAY_LIMIT=100
# TOOL_LIST_MAX_PAGES=10
# TOOL_LIST_MAX_ROWS=1000
# TOOL_LIST_MAP_LLM_MAX_CONCURRENT=3
# TOOL_LIST_MAX_HTTP_PER_TURN=60

# Session memory: GOA deterministic write (recentEpisodes / taskState). No AGENT_WORKING_MEMORY_MODE.

# Final answer summarizer (streamSummarizerResult) output max_tokens
AGENT_SUMMARIZE_TOOL_MAX_TOKENS=2048
AGENT_SUMMARIZE_TOOL_DETAIL_MAX_TOKENS=4096
# AGENT_SUMMARIZE_SMALLTALK_MAX_TOKENS=256
# AGENT_DETAIL_REPLY_SKIP_SUMMARIZE_MAX_CHARS=12000

# Default X-SHOP-ID header for product APIs (integer, US site)
AGENT_DEFAULT_X_SHOP_ID=2022
# AGENT_CA_X_SHOP_ID=2023

# Multi-turn session history compression (Redis); see src/core/memory/context/session-history-compression.md
# SESSION_HISTORY_COMPRESS=0
# SESSION_HISTORY_COMPRESS_AFTER_TURNS=24
# SESSION_HISTORY_KEEP_RECENT_TURNS=12
# SESSION_HISTORY_TRIM_TURNS_AFTER_COMPRESS=0

# Separate embedding gateway (required for vector mode on vLLM/chat-only hosts)
# AGENT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_EMBEDDING_API_KEY=
# AGENT_EMBEDDING_MODEL=text-embedding-v3
# AGENT_EMBEDDING_PATH=/v1/embeddings

# Local transformers embedding — prefer DB LlmModelConfig kind=transformers_embedding
# Env fallback when DB not seeded:
# AGENT_EMBEDDING_LOCAL_MODEL=https://media.cdn.a-premium.com/static/models/all-MiniLM-L6-v2
# AGENT_EMBEDDING_LOCAL_ALLOW_REMOTE=true
# AGENT_EMBEDDING_LOCAL_MODEL_PATH=
